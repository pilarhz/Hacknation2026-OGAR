# Skopiuj do .env i dostosuj. Wszystkie zmienne są opcjonalne.

# --- Serwer ---
PORT=8080
HOST=127.0.0.1
# Baza: PostgreSQL. Z DATABASE_URL – serwer; bez niego – wbudowany PostgreSQL (PGlite) w katalogu DB_PATH.
# DATABASE_URL=postgres://ogar:haslo@127.0.0.1:5432/ogar
DB_PATH=apps/api/data/pg
# API_TOKEN=zmien-mnie            # jeśli ustawiony, API wymaga nagłówka X-Api-Token

# --- Źródła Web2 ---
SOURCES=github,keybase,gravatar,hackernews,web,wayback   # reddit wymaga OAuth (403), sandbox = dane syntetyczne
SANDBOX_URL=http://127.0.0.1:4100
# GITHUB_TOKEN=                    # podnosi limit GitHub API z 60 do 5000 zapytań/h
# SEARXNG_URL=http://127.0.0.1:8888 # własna instancja SearXNG (metawyszukiwarka, on-premise)
ALLOW_USER_URLS=true               # strony podane WPROST w danych wejściowych; strony z pivotu wymagają zatwierdzenia hosta w UI
# ALLOWED_HOSTS=...                # nadpisuje białą listę hostów (patrz apps/api/src/config.ts)

# --- Blockchain (publiczne API, bez kluczy) ---
CHAIN_LIVE=true
BLOCKSCOUT_URL=https://eth.blockscout.com
ESPLORA_URL=https://blockstream.info/api
TRONGRID_URL=https://api.trongrid.io
# TRONSCAN_API_KEY=                # opcjonalnie – Tronscan zamiast TronGrid (etykiety adresów TRON)

# --- AI (domyślnie wyłączone; dowolny serwer zgodny z OpenAI /v1, np. lokalna Ollama) ---
AI_PROVIDER=none                   # none | openai-compatible
AI_BASE_URL=http://127.0.0.1:11434/v1
AI_MODEL=llama3.1:8b
# AI_API_KEY=

# --- Sieć ---
REQUEST_TIMEOUT_MS=12000
PER_HOST_DELAY_MS=400
CACHE_TTL_MINUTES=30
SCHEDULER_TICK_MS=30000
